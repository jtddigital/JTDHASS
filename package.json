{
  "name": "jtdhass",
  "description": "Home Assistant dashboard cards and other add-ons by JTD.",
  "type": "module",
  "private": true,
  "workspaces": [
    "cards/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
